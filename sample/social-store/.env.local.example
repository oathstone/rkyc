# ── Convex ────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.convex.dev → your project → Settings
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ── RKYC ──────────────────────────────────────────────────────────────────────
# No API key needed — RKYC uses public JWKS verification.
# The RKYC_ISSUER and JWKS_URL are public endpoints — no secrets required.
NEXT_PUBLIC_RKYC_ISSUER=https://business.oathstone.cloud
NEXT_PUBLIC_RKYC_JWKS_URL=https://enduring-salmon-903.convex.site/.well-known/rkyc-jwks.json
